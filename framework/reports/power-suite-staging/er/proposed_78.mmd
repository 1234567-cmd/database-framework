%% Proposed schema of power-suite-staging (78 of 80: around admin_users)
%% 1552 manual or refused plan step(s) are not shown as applied.
erDiagram
    admin_audit_log {
        bigint id PK
        int admin_user_id FK
        varchar_100 action
        varchar_50 target_type
        varchar_100 target_id
        varchar_255 company_code
        json detail
        varchar_45 ip_address
        datetime created_at
        varchar_255 created_by "proposed: added"
        timestamp updated_at "proposed: added"
        timestamp updated_at "proposed: added"
        varchar_255 updated_by "proposed: added"
    }
    admin_sessions {
        int id PK
        int admin_user_id FK
        char_64 token_hash
        varchar_45 ip_address
        varchar_255 user_agent
        datetime issued_at
        datetime last_seen_at
        datetime expires_at
        datetime revoked_at
        timestamp created_at "proposed: added"
        varchar_255 created_by "proposed: added"
        timestamp updated_at "proposed: added"
        timestamp updated_at "proposed: added"
        varchar_255 updated_by "proposed: added"
    }
    admin_settings {
        varchar_64 setting_key PK
        text value
        int admin_user_id FK "proposed: added"
        datetime updated_at
        timestamp created_at "proposed: added"
        varchar_255 created_by "proposed: added"
    }
    admin_users {
        int id PK
        varchar_255 email
        varchar_200 password
        varchar_200 full_name
        enum_owner_operator_viewer role
        tinyint_1 is_active
        varchar_255 mfa_secret
        datetime last_login_at
        int failed_attempts
        datetime locked_until_at "proposed: added"
        datetime created_at
        datetime updated_at
        varchar_255 created_by "proposed: added"
        varchar_255 updated_by "proposed: added"
    }
    coa_template_rows {
        bigint id PK
        int coa_template_id FK "proposed: added"
        enum_account_posting_rule_lookup row_type
        json payload
        timestamp created_at "proposed: added"
        varchar_255 created_by "proposed: added"
        timestamp updated_at "proposed: added"
        timestamp updated_at "proposed: added"
        varchar_255 updated_by "proposed: added"
    }
    coa_templates {
        bigint id PK "proposed: changed"
        varchar_120 name
        int version
        varchar_255 source_company_code
        text note
        int admin_user_id FK "proposed: added"
        datetime created_at
        timestamp updated_at "proposed: added"
        timestamp updated_at "proposed: added"
        varchar_255 updated_by "proposed: added"
    }
    provisioning_runs {
        int id PK
        varchar_255 company_code
        enum_provision_add_branch_repair_rollover kind
        json params
        enum_running_succeeded_failed status
        int current_step
        json step_log
        json verification
        text error
        int admin_user_id FK "proposed: added"
        datetime started_at
        datetime heartbeat_at
        datetime finished_at
        timestamp created_at "proposed: added"
        varchar_255 created_by "proposed: added"
        timestamp updated_at "proposed: added"
        timestamp updated_at "proposed: added"
        varchar_255 updated_by "proposed: added"
    }
    admin_users ||--o{ admin_audit_log : "admin_user_id (proposed)"
    admin_users ||--o{ admin_sessions : "admin_user_id"
    admin_users ||--o{ admin_settings : "admin_user_id (proposed)"
    coa_templates ||--o{ coa_template_rows : "coa_template_id (proposed)"
    admin_users ||--o{ coa_templates : "admin_user_id (proposed)"
    admin_users ||--o{ provisioning_runs : "admin_user_id (proposed)"
